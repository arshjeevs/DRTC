#!/bin/bash
# H200 GPU server only, inside the drtc_lab container (lab/bin/h200-start): one-time environment setup.
# Everything goes into /workspace/drtc_lab (the repo), which outlives the --rm container:
#   .tools/          uv and the Python it manages
#   .venv/           project environment (PyTorch for CUDA 12.8)
#   .cache/          Hugging Face downloads (datasets, base models) and the uv cache
#   .server.env      H200-only settings, sourced by lab/bin/_env (absent on every other machine)
#   .secrets.env     HF_TOKEN / WANDB_API_KEY (you create it; mode 600; never in git)
# Safe to re-run (e.g. after a git pull that changed dependencies).
set -e
REPO=/workspace/drtc_lab
[ -n "$NVIDIA_PYTORCH_VERSION" ] && [ -d "$REPO/lab" ] || {
    echo "h200-setup runs inside the drtc_lab container on the H200 server (see lab/H200.md)."; exit 1; }
cd "$REPO"

cat > .server.env <<'EOF'
# H200 server only (written by lab/bin/h200-setup; sourced by lab/bin/_env).
export PATH="/workspace/drtc_lab/.tools/bin:$PATH"
export UV_PYTHON_INSTALL_DIR=/workspace/drtc_lab/.tools/python
export UV_CACHE_DIR=/workspace/drtc_lab/.cache/uv
export UV_LINK_MODE=copy
export HF_HOME=/workspace/drtc_lab/.cache/huggingface
if [ -f /workspace/drtc_lab/.secrets.env ]; then set -a; . /workspace/drtc_lab/.secrets.env; set +a; fi
EOF
. ./.server.env

echo "== uv"
command -v uv >/dev/null || python3 -m pip install --quiet --target .tools uv   # uv lands in .tools/bin
uv --version

echo "== .venv (PyTorch for CUDA 12.8; takes a few minutes the first time)"
[ -x .venv/bin/python ] || uv venv --python 3.12 .venv
uv pip install --python .venv/bin/python --torch-backend cu128 -e ".[smolvla,async]"
.venv/bin/python -c "import torch; print('torch', torch.__version__, '| GPU:', torch.cuda.get_device_name(0))"

[ -f .secrets.env ] || echo "NOTE: create .secrets.env with HF_TOKEN=... and WANDB_API_KEY=... (chmod 600)"

# The container runs as root (guide default); hand the files back to the server account so they can
# be deleted without docker. Re-run after training: lab/bin/h200-own
chown -R "$(stat -c %u:%g /workspace)" "$REPO"
echo "Setup done. Start Jupyter (guide step 6): cd /workspace && jupyter-notebook"
