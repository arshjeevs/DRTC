#!/bin/bash
# H200 server only, inside the drtc_lab container: give files created as root (the container's user)
# back to the server account, so checkpoints and logs can be deleted without docker.
[ -n "$NVIDIA_PYTORCH_VERSION" ] && [ -d /workspace/drtc_lab ] || { echo "Run inside the drtc_lab container on the H200."; exit 1; }
chown -R "$(stat -c %u:%g /workspace)" /workspace/drtc_lab && echo "ownership fixed: /workspace/drtc_lab"
