#!/bin/bash
# H200 server only, inside the drtc_lab container: give files created as root back to the server account, for this
# checkout only (e.g. /workspace/drtc_major).
here="$(cd "$(dirname "$0")/../.." && pwd)"
[ -n "$NVIDIA_PYTORCH_VERSION" ] && [ -d /workspace ] || { echo "Run inside the drtc_lab container on the H200."; exit 1; }
chown -R "$(stat -c %u:%g /workspace)" "$here" && echo "ownership fixed: $here"
