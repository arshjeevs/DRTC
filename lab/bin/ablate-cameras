#!/bin/bash
# Single-camera copies of a dataset, pushed to the Hub (the original is not modified):
#   lab/bin/ablate-cameras <hf_user>/<dataset> [scene] [wrist]     (default: scene)
#     scene  -> <dataset>_scene   camera2 (scene) only
#     wrist  -> <dataset>_wrist   camera1 (wrist) only
source "$(dirname "$0")/_env"
set -e
repo="$1"; shift || true
[ -n "$repo" ] || { echo "usage: lab/bin/ablate-cameras <hf_user>/<dataset> [scene] [wrist]"; exit 1; }
for variant in "${@:-scene}"; do
    case "$variant" in
        scene) drop=camera1 ;;
        wrist) drop=camera2 ;;
        *) echo "unknown variant $variant (scene or wrist)"; exit 1 ;;
    esac
    echo "== ${repo}_$variant (removing $drop)"
    "$PY" -m lerobot.scripts.lerobot_edit_dataset --repo_id "$repo" --new_repo_id "${repo}_$variant" \
        --operation.type remove_feature --operation.feature_names "['observation.images.$drop']" --push_to_hub true
done
