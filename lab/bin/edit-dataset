#!/bin/bash
# Review and trim a dataset in the browser (github.com/acrosson/lerobot-dataset-editor), on a
# separate _trim copy so the recorded dataset and the models trained on it stay as they are:
#   lab/bin/edit-dataset <hf_user>/<dataset> [--port N]     copy to <dataset>_trim (first time) and open the editor
#   lab/bin/edit-dataset <hf_user>/<dataset> --auto [opts]  same, with the idle start/end of every episode
#                                                           already cropped (lab/tools/autotrim.py) for review
#   lab/bin/edit-dataset <hf_user>/<dataset> --auto --apply write the automatic crops without opening the editor
#   lab/bin/edit-dataset <hf_user>/<dataset> --auto --dry-run   only print what would be cropped
#   lab/bin/edit-dataset <hf_user>/<dataset>_trim --push    push the trimmed copy to the Hub
# --auto options (python -m lab.tools.autotrim -h): --replace (discard staged edits), --pad S, --move F,
# --delete-static, --show N.
#
# The editor stages edits in <copy>/_editor/ and writes them only on Save (backup in <copy>/_backups/).
# After deleting episodes, set `total` in models.yaml's trim split to the new episode count.
source "$(dirname "$0")/_env"
set -e
repo="$1"; shift || true
[ -n "$repo" ] && [[ "$repo" == */* ]] || { echo "usage: lab/bin/edit-dataset <hf_user>/<dataset> [--port N] | <hf_user>/<dataset>_trim --push"; exit 1; }

LEROBOT_HOME="${HF_LEROBOT_HOME:-$HOME/.cache/huggingface/lerobot}"
trim="${repo%_trim}_trim"
src="$LEROBOT_HOME/$repo"
dst="$LEROBOT_HOME/$trim"

if [ "$1" = "--push" ]; then
    [ -d "$dst" ] || { echo "no local copy $dst"; exit 1; }
    session="$dst/_editor/session.json"
    if [ -s "$session" ] && "$PY" -c "import json,sys; d=json.load(open(sys.argv[1])); sys.exit(0 if d.get('edits') else 1)" "$session" 2>/dev/null; then
        echo "warning: $session has staged edits that were not saved (Save in the editor, or Revert)"
    fi
    echo "== pushing $trim (data/, meta/, videos/ only; not _editor/ or _backups/)"
    exec "$PY" - "$trim" "$dst" <<'EOF'
import sys
from lerobot.datasets.lerobot_dataset import LeRobotDataset
repo_id, root = sys.argv[1], sys.argv[2]
ds = LeRobotDataset(repo_id, root=root)
print(f"{ds.meta.total_episodes} episodes, {ds.meta.total_frames} frames")
ds.push_to_hub(allow_patterns=["data/*", "meta/*", "videos/*"])
print(f"pushed https://huggingface.co/datasets/{repo_id}")
EOF
fi

# The editor itself: a sibling checkout, pinned to the commit this script was tested with.
EDITOR_DIR="${LRDE_DIR:-$(dirname "$REPO_ROOT")/lerobot-dataset-editor}"
EDITOR_COMMIT=dfac5b8
if [ ! -f "$EDITOR_DIR/server.py" ]; then
    git clone https://github.com/acrosson/lerobot-dataset-editor.git "$EDITOR_DIR"
    git -C "$EDITOR_DIR" checkout -q "$EDITOR_COMMIT"
fi
command -v ffmpeg >/dev/null || { echo "ffmpeg is needed for the video previews (sudo apt install ffmpeg)"; exit 1; }

if [ ! -d "$dst" ]; then
    [ -f "$src/meta/info.json" ] || { echo "no local dataset $src (download it first, e.g. lab/bin/train or lerobot-dataset-viz)"; exit 1; }
    echo "== copying $repo -> $trim (the original is not modified)"
    cp -a "$src" "$dst"
fi

if [ "$1" = "--auto" ]; then
    shift
    LRDE_DIR="$EDITOR_DIR" "$PY" -m lab.tools.autotrim "$dst" "$@"
    for a in "$@"; do case "$a" in --apply|--dry-run) exit 0 ;; esac; done
    echo "== opening the editor to review the crops (Save writes them)"
    set --
fi

# The repo's venv has lerobot, so the editor writes the same statistics lerobot-train computes.
# Rooted at the copy only: the editor cannot open (or save into) any other dataset.
LRDE_PYTHON="$PY" exec "$EDITOR_DIR/run.sh" --root "$dst" "$@"
