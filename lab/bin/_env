# Sourced by lab/bin scripts (new setup, branch major): repo root, the venv's `lab` command, rig values.
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
[ -f "$REPO_ROOT/.server.env" ] && . "$REPO_ROOT/.server.env"   # H200 only
LAB="$REPO_ROOT/.venv/bin/lab"
cd "$REPO_ROOT"
[ -x "$LAB" ] || { echo "Missing $LAB: run 'uv sync --extra gpu' (laptop/H200) or 'uv sync' (Pi) in $REPO_ROOT"; exit 1; }
rig() { "$LAB" rig "$1"; }
